  author = {Kim, Shinn and Lee, Soobin and Shin, Kyoungseob and Kim, Han-Soo and Kim, Yongsung and Kim, Minsu and Nam, Juhong and Ko, Somang and Kwon, Daeheon and Huh, Wook and Han, Ilkyu and Kwon, Sunghoon},
